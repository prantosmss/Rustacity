rustacity_CPPFLAGS = -std=c++11 -Wno-deprecated-declarations \
	-D__STDC_CONSTANT_MACROS -DWXINTL_NO_GETTEXT_MACRO \
	-DPKGLIBDIR=\"$(pkglibdir)\" -DLIBDIR=\"$(libdir)\" \
